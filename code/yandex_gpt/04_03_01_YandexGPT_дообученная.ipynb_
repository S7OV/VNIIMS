0\\u0435\\u0434\\u0430\\u0447\\u0438 \\u0441\\u0432\\u0435\\u0434\\u0435\\u043d\\u0438\\u0439 \\u0432 \\u043d\\u0435\\u0433\\u043e \\u0438 \\u0432\\u043d\\u0435\\u0441\\u0435\\u043d\\u0438\\u044f \\u0438\\u0437\\u043c\\u0435\\u043d\\u0435\\u043d\\u0438\\u0439 \\u0432 \\u0434\\u0430\\u043d\\u043d\\u044b\\u0435 \\u0441\\u0432\\u0435\\u0434\\u0435\\u043d\\u0438\\u0439, \\u043f\\u0440\\u0435\\u0434\\u043e\\u0441\\u0442\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u044f \\u0441\\u043e\\u0434\\u0435\\u0440\\u0436\\u0430\\u0449\\u0438\\u0445\\u0441\\u044f \\u0432 \\u043d\\u0435\\u043c \\u0434\\u043e\\u043a\\u0443\\u043c\\u0435\\u043d\\u0442\\u043e\\u0432 \\u0438 \\u0441\\u0432\\u0435\\u0434\\u0435\\u043d\\u0438\\u0439, \\u0443\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u043d\\u043e\\u0433\\u043e \\u043f\\u0440\\u0438\\u043a\\u0430\\u0437\\u043e\\u043c \\u041c\\u0438\\u043d\\u043f\\u0440\\u043e\\u043c\\u0442\\u043e\\u0440\\u0433\\u0430 \\u0420\\u043e\\u0441\\u0441\\u0438\\u0438 \\u043e\\u0442 28.08.2020 \\u2116 2906, \\u0432 \\u043f\\u0440\\u0435\\u0434\\u043e\\u0441\\u0442\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u0438 \\u0434\\u043e\\u043a\\u0443\\u043c\\u0435\\u043d\\u0442\\u043e\\u0432 \\u0438 \\u0441\\u0432\\u0435\\u0434\\u0435\\u043d\\u0438\\u0439, \\u0441\\u043e\\u0434\\u0435\\u0440\\u0436\\u0430\\u0449\\u0438\\u0445\\u0441\\u044f \\u0432 \\u0424\\u043e\\u043d\\u0434\\u0435, \\u0420\\u043e\\u0441\\u0441\\u0442\\u0430\\u043d\\u0434\\u0430\\u0440\\u0442 \\u043e\\u0442\\u043a\\u0430\\u0437\\u044b\\u0432\\u0430\\u0435\\u0442, \\u0432 \\u0442\\u043e\\u043c \\u0447\\u0438\\u0441\\u043b\\u0435, \\u0432 \\u0441\\u043b\\u0443\\u0447\\u0430\\u0435, \\u0435\\u0441\\u043b\\u0438 \\u043f\\u043e\\u043b\\u0443\\u0447\\u0435\\u043d\\u0438\\u0435 \\u0441\\u0432\\u0435\\u0434\\u0435\\u043d\\u0438\\u0439 \\u0442\\u0440\\u0435\\u0431\\u0443\\u0435\\u0442 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0434\\u0435\\u043d\\u0438\\u044f \\u0430\\u043d\\u0430\\u043b\\u0438\\u0437\\u0430