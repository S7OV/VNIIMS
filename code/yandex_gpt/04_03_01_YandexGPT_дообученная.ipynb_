4\\u0441\\u0442\\u0432 \\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u0439, \\u0432\\u043a\\u043b\\u044e\\u0447\\u0435\\u043d\\u043d\\u044b\\u043c\\u0438 \\u0432 \\u0424\\u0435\\u0434\\u0435\\u0440\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0438\\u043d\\u0444\\u043e\\u0440\\u043c\\u0430\\u0446\\u0438\\u043e\\u043d\\u043d\\u044b\\u0439 \\u0444\\u043e\\u043d\\u0434 \\u043f\\u043e \\u043e\\u0431\\u0435\\u0441\\u043f\\u0435\\u0447\\u0435\\u043d\\u0438\\u044e \\u0435\\u0434\\u0438\\u043d\\u0441\\u0442\\u0432\\u0430 \\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u0439, \\u0432\\u043d\\u0435\\u0441\\u0435\\u043d\\u0430 \\u0424\\u0435\\u0434\\u0435\\u0440\\u0430\\u043b\\u044c\\u043d\\u044b\\u043c \\u0437\\u0430\\u043a\\u043e\\u043d\\u043e\\u043c \\u043e\\u0442 27.12.2019 \\u2116 496-\\u0424\\u0417 \\u00ab\\u041e \\u0432\\u043d\\u0435\\u0441\\u0435\\u043d\\u0438\\u0438 \\u0438\\u0437\\u043c\\u0435\\u043d\\u0435\\u043d\\u0438\\u0439 \\u0432 \\u0424\\u0435\\u0434\\u0435\\u0440\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0437\\u0430\\u043a\\u043e\\u043d \\u00ab\\u041e\\u0431 \\u043e\\u0431\\u0435\\u0441\\u043f\\u0435\\u0447\\u0435\\u043d\\u0438\\u0438 \\u0435\\u0434\\u0438\\u043d\\u0441\\u0442\\u0432\\u0430 \\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u0439\\u00bb \\u0438 \\u0432\\u0441\\u0442\\u0443\\u043f\\u0438\\u043b\\u0430 \\u0432 \\u0441\\u0438\\u043b\\u0443 \\u0441 24.09.2020. \\u0414\\u043e \\u0443\\u043a\\u0430\\u0437\\u0430\\u043d\\u043d\\u043e\\u0439 \\u0434\\u0430\\u0442\\u044b \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u044b \\u043f\\u043e\\u0432\\u0435\\u0440\\u043a\\u0438 \\u0441\\u0440\\u0435\\u0434\\u0441\\u0442\\u0432 \\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u0439, \\u0432 \\u0441\\u043e\\u043e\\u0442\\u0432\\u0435\\u0442\\u0441\\u0442\\u0432\\u0438\\u0438 \\u0441 \\u043f\\u0443\\u043d\\u043a\\u0442\\u043e\\u043c 4  \\u041f\\u043e\\u0440\\u044f\\u0434\\u043a\\u0430 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0434\\u0435\\u043d\\u0438\\u044f \\u043f\\u043e\\u0432\\u0435\\u0440\\u043a\\u0438 \\u0441\\u0440\\u0435\\u0434\\u0441\\u0442\\u0432 \\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u0439, \\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u0439 \\u043a \\u0437\\u043d\\u0430\\u043a\\u0443 \\u043f\\u043e\\u0432\\u0435\\u0440\\u043a\\u0438 \\u0438 \\u0441\\u043e\\u0434\\u0435\\u0440\\u0436\\u0430\\u043d\\u0438\\u044e \\u0441\\u0432\\u0438\\u0434\\u0435\\u0442\\u0435\\u043b\\u044c\\u0441\\u0442\\u0432\\u0430 \\u043e \\u043f\\u043e\\u0432\\u0435\\u0440\\u043a\\u0435, \\u0443\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u043d\\u043e\\u0433\\u043e \\u043f\\u0440\\u0438\\u043a\\u0430\\u0437\\u043e\\u043c \\u041c\\u0438\\u043d\\u043f\\u0440\\u043e\\u043c\\u0442\\u043e\\u0440\\u0433\\u0430 \\u0420\\u043e\\u0441\\u0441\\u0438\\u0438 \\u043e\\u0442 02.07.2015 \\u2116 1815 (\\u0434\\u0430\\u043b\\u0435\\u0435 \\u2013 \\u041f\\u043e\\u0440\\u044f\\u0434\\u043e\\u043a), \\u0443\\u0434\\u043e\\u0441\\u0442\\u043e\\u0432\\u0435\\u0440\\u044f\\u043b\\u0438\\u0441\\u044c \\u0437\\u043d\\u0430\\u043a\\u043e\\u043c \\u043f\\u043e\\u0432\\u0435\\u0440\\u043a\\u0438 \\u0438 (\\u0438\\u043b\\u0438) \\u0441\\u0432\\u0438\\u0434\\u0435\\u0442\\u0435\\u043b\\u044c\\u0441\\u0442\\u0432\\u043e\\u043c \\u043e \\u043f\\u043e\\u0432\\u0435\\u0440\\u043a\\u0435, \\u0438 (\\u0438\\u043b\\u0438) \\u0437\\u0430\\u043f\\u0438\\u0441\\u044c\\u044e \\u0432 \\u043f\\u0430\\u0441\\u043f\\u043e\\u0440\\u0442\\u0435 (\\u0444\\u043e\\u0440\\u043c\\u0443\\u043b\\u044f\\u0440\\u0435) \\u0441\\u0440\\u0435\\u0434\\u0441\\u0442\\u0432 \\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u0439, \\u0437\\u0430\\u0432\\u0435\\u0440\\u044f\\u0435\\u043c\\u043e\\u0439 \\u043f\\u043e\\u0434\\u043f\\u0438\\u0441\\u044c\\u044e \\u0440\\u0430\\u0431\\u043e\\u0442\\u043d\\u0438\\u043a\\u0430 \\u0430\\u043a\\u043a\\u0440\\u0435\\u0434\\u0438\\u0442\\u043e\\u0432\\