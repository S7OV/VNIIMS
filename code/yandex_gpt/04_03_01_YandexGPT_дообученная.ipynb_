\u0435\\u0440\\u0435\\u0434\\u0430\\u0447\\u0438 \\u0441\\u0432\\u0435\\u0434\\u0435\\u043d\\u0438\\u0439 \\u0432 \\u043d\\u0435\\u0433\\u043e \\u0438 \\u0432\\u043d\\u0435\\u0441\\u0435\\u043d\\u0438\\u044f \\u0438\\u0437\\u043c\\u0435\\u043d\\u0435\\u043d\\u0438\\u0439 \\u0432 \\u0434\\u0430\\u043d\\u043d\\u044b\\u0435 \\u0441\\u0432\\u0435\\u0434\\u0435\\u043d\\u0438\\u0439, \\u043f\\u0440\\u0435\\u0434\\u043e\\u0441\\u0442\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u044f \\u0441\\u043e\\u0434\\u0435\\u0440\\u0436\\u0430\\u0449\\u0438\\u0445\\u0441\\u044f \\u0432 \\u043d\\u0435\\u043c \\u0434\\u043e\\u043a\\u0443\\u043c\\u0435\\u043d\\u0442\\u043e\\u0432 \\u0438 \\u0441\\u0432\\u0435\\u0434\\u0435\\u043d\\u0438\\u0439, \\u0443\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u043d\\u043e\\u0433\\u043e \\u043f\\u0440\\u0438\\u043a\\u0430\\u0437\\u043e\\u043c \\u041c\\u0438\\u043d\\u043f\\u0440\\u043e\\u043c\\u0442\\u043e\\u0440\\u0433\\u0430 \\u0420\\u043e\\u0441\\u0441\\u0438\\u0438 \\u043e\\u0442 28.08.2020 \\u2116 2906, \\u0432 \\u043f\\u0440\\u0435\\u0434\\u043e\\u0441\\u0442\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u0438 \\u0434\\u043e\\u043a\\u0443\\u043c\\u0435\\u043d\\u0442\\u043e\\u0432 \\u0438 \\u0441\\u0432\\u0435\\u0434\\u0435\\u043d\\u0438\\u0439, \\u0441\\u043e\\u0434\\u0435\\u0440\\u0436\\u0430\\u0449\\u0438\\u0445\\u0441\\u044f \\u0432 \\u0424\\u043e\\u043d\\u0434\\u0435, \\u0420\\u043e\\u0441\\u0441\\u0442\\u0430\\u043d\\u0434\\u0430\\u0440\\u0442 \\u043e\\u0442\\u043a\\u0430\\u0437\\u044b\\u0432\\u0430\\u0435\\u0442, \\u0432 \\u0442\\u043e\\u043c \\u0447\\u0438\\u0441\\u043b\\u0435, \\u0432 \\u0441\\u043b\\u0443\\u0447\\u0430\\u0435, \\u0435\\u0441\\u043b\\u0438 \\u043f\\u043e\\u043b\\u0443\\u0447\\u0435\\u043d\\u0438\\u0435 \\u0441\\u0432\\u0435\\u0434\\u0435\\u043d\\u0438\\u0439 \\u0442\\u0440\\u0435\\u0431\\u0443\\u0435\\u0442 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0434\\u0435\\u043d\\u0438\\u044f \\u0430\\u043d\\u0430\\u043b\\u0438\\u0437\\u0430 \\u0438\\u043b\\u0438 \\u0438\\u0441\\u0441\\u043b\\u0435\\u0434\\u043e\\u0432\\u0430\\u043d\\u0438\\u0439 \\u0434\\u043e\\u043a\\u0443\\u043c\\u0435\\u043d\\u0442\\u043e\\u0432 \\u0438 \\u0441\\u0432\\u0435\\u0434\\u0435\\u043d\\u0438\\u0439, \\u0441\\u043e\\u0434\\u0435\\u0440\\u0436\\u0430\\u0449\\u0438\\u0445\\u0441\\u044f \\u0432 \\u0424\\u043e\\u043d\\u0434\\u0435. \\u0412 \\u043f\\u043e\\u0440\\u044f\\u0434\\u043a\\u0435 \\u0438\\u043d\\u0444\\u043e\\u0440\\u043c\\u0430\\u0446\\u0438\\u0438 \\u0441\\u043e\\u043e\\u0431\\u0449\\u0430\\u0435\\u043c, \\u0447\\u0442\\u043e \\u0441\\u0440\\u0435\\u0434\\u0441\\u0442\\u0432\\u0430 \\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u0439, \\u0437\\u0430\\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u043d\\u044b\\u0435 \\u0432 \\u0424\\u043e\\u043d\\u0434\\u0435 \\u043f\\u043e\\u0434 \\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u044b\\u043c\\u0438 \\u043d\\u043e\\u043c\\u0435\\u0440\\u0430\\u043c\\u0438, \\u044f\\u0432\\u043b\\u044f\\u044e\\u0442\\u0441\\u044f \\u0440\\u0430\\u0437\\u043d\\u044b\\u043c\\u0438 \\u0441\\u0440\\u0435\\u0434\\u0441\\u0442\\u0432\\u0430\\u043c\\u0438 \\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u0439.\",\n          \"\\u0418\\u043d\\u0444\\u043e\\u0440\\u043c\\u0438\\u0440\\u0443\\u0435\\u043c, \\u0447\\u0442\\u043e \\u043d\\u043e\\u0440\\u043c\\u0430 \\u043e \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u0438 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u043e\\u0432 \\u043f\\u043e\\u0432\\u0435\\u0440\\u043a\\u0438 \\u0441\\u0440\\u0435\\u0434\\u0441\\u0442\\u0432 \\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u0439 \\u0441\\u0432\\u0435\\u0434\\u0435\\u043d\\u0438\\u044f\\u043c\\u0438 \\u043e \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u0430\\u0445 \\u043f\\u043e\\u0432\\u0435\\u0440\\u043a\\u0438 \\u0441\\u0440\\u0435\\u0434\\u0441\\u0442\\u0432 \\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u0439, \\u0432\\u043a\\u043b\\u044e\\u0447\\u0435\\u043d\\u043d\\u044b\\u043c\\u0438 \\u0432 \\u0424\\u0435\\u0434\\u0435\\u0440\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0438\\u043d\\u0444\\u043e\\u0440\\u043c\\u0430\\u0446\\u0438\\u043e\\u043d\\u043d\\u044b\\u0439 \\u0444\\u043e\\u043d\\u0434 \\u043f\\u043e \\u043e\\u0431\\u0435\\u0441\\u043f\\u0435\\u0447\\u0435\\u043d\\u0438\\u044e \\u0435\\u0434\\u0438\\u043d\\u0441\\u0442\\u0432\\u0430 \\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u0439, \\u0432\\u043d\\u0435\\u0441\\u0435\\u043d\\u0430 \\u0424\\u0435\\u0434\\u0435\\u0440\\u0430\\u043b\\u044c\\u043d\\u044b\\u043c \\u0437\\u0430\\u043a\\u043e\\u043d\\u043e\\u043c \\u043e\\u0442 27.12.2019 \\u2116 496-\\u0424\\u0417 \\u00ab\\u041e \\u0432\\u043d\\u0435\\u0441\\u0435\\u043d\\u0438\\u0438 \\u0438\\u0437\\u043c\\u0435\\u043d\\u0435\\u043d\\u0438\\u0439 \\u0432 \\u0424\\u0435\\u0434\\u0435\\u0440\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0437\\u0430\\u043a\\u043e\\u043d \\u00ab\\u041e\\u0431 \\u043e\\u0431\\u0435\\u0441\\u043f\\u0435\\u0447\\u0435\\u043d\\u0438\\u0438 \\u0435\\u0434\\u0438\\u043d\\u0441\\u0442\\u0432\\u0430 \\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u0439\\u00bb \\u0438 \\u0432\\u0441\\u0442\\u0443\\u043f\\u0438\\u043b\\u0430 \\u0432 \\u0441\\u0438\\u043b\\u0443 \\u0441 24.09.2020. \\u0414\\u043e \\u0443\\u043a\\u0430\\u0437\\u0430\\u043d\\u043d\\u043e\\u0439 \\u0434\\u0430\\u0442\\u044b \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442\\u044b \\u043f\\u043e\\u0432\\u0435\\u0440\\u043a\\u0438 \\u0441\\u0440\\u0435\\u0434\\u0441\\u0442\\u0432 \\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u0439, \\u0432 \\u0441\\u043e\\u043e\\u0442\\u0432\\u0435\\u0442\\u0441\\u0442\\u0432\\u0438\\u0438 \\u0441 \\u043f\\u0443\\u043d\\u043a\\u0442\\u043e\\u043c 4  \\u041f\\u043e\\u0440\\u044f\\u0434\\u043a\\u0430 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0434\\u0435\\u043d\\u0438\\u044f \\u043f\\u043e\\u0432\\u0435\\u0440\\u043a\\u0438 \\u0441\\u0440\\u0435\\u0434\\u0441\\u0442\\u0432 \\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u0439, \\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u0439 \\u043a \\u0437\\u043d\\u0430\\u043a\\u0443 \\u043f\\u043e\\u0432\\u0435\\u0440\\u043a\\u0438 \\u0438 \\u0441\\u043e\\u0434\\u0435\\u0440\\u0436\\u0430\\u043d\\u0438\\u044e \\u0441\\u0432\\u0438\\u0434\\u0435\\u0442\\u0435\\u043b\\u044c\\u0441\\u0442\\u0432\\u0430 \\u043e \\u043f\\u043e\\u0432\\u0435\\u0440\\u043a\\u0435, \\u0443\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u043d\\u043e\\u0433\\u043e \\u043f\\u0440\\u0438\\u043a\\u0430\\u0437\\u043e\\u043c \\u041c\\u0438\\u043d\\u043f\\u0440\\u043e\\u043c\\u0442\\u043e\\u0440\\u0433\\u0430 \\u0420\\u043e\\u0441\\u0441\\u0438\\u0438 \\u043e\\u0442 02.07.2015 \\u2116 1815 (\\u0434\\u0430\\u043b\\u0435\\u0435 \\u2013 \\u041f\\u043e\\u0440\\u044f\\u0434\\u043e\\u043a), \\u0443\\u0434\\u043e\\u0441\\u0442\\u043e\\u0432\\u0435\\u0440\\u044f\\u043b\\u0438\\u0441\\u044c \\u0437\\u043d\\u0430\\u043a\\u043e\\u043c \\u043f\\u043e\\u0432\\u0435\\u0440\\u043a\\u0438 \\u0438 (\\u0438\\u043b\\u0438) \\u0441\\u0432\\u0438\\u0434\\u0435\\u0442\\u0435\\u043b\\u044c\\u0441\\u0442\\u0432\\u043e\\u043c \\u043e \\u043f\\u043e\\u0432\\u0435\\u0440\\u043a\\u0435, \\u0438 (\\u0438\\u043b\\u0438) \\u0437\\u0430\\u043f\\u0438\\u0441\\u044c\\u044e \\u0432 \\u043f\\u0430\\u0441\\u043f\\u043e\\u0440\\u0442\\u0435 (\\u0444\\u043e\\u0440\\u043c\\u0443\\u043b\\u044f\\u0440\\u0435) \\u0441\\u0440\\u0435\\u0434\\u0441\\u0442\\u0432 \\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u0439, \\u0437\\u0430\\u0432\\u0435\\u0440\\u044f\\u0435\\u043c\\u043e\\u0439 \\u043f\\u043e\\u0434\\u043f\\u0438\\u0441\\u044c\\u044e \\u0440\\u0430\\u0431\\u043e\\u0442\\u043d\\u0438\\u043a\\u0430 \\u0430\\u043a\\u043a\\u0440\\u0435\\u0434\\u0438\\u0442\\u043e\\u0432\\u0430\\u043d\\u043d\\u043e\\u0433\\u043e \\u044e\\u0440\\u0438\\u0434\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u0433\\u043e \\u043b\\u0438\\u0446\\u0430 \\u0438\\u043b\\u0438 \\u0438\\u043d\\u0434\\u0438\\u0432\\u0438\\u0434\\u0443\\u0430\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u043f\\u0440\\u0435\\u0434\\u043f\\u0440\\u0438\\u043d\\u0438\\u043c\\u0430\\u0442\\u0435\\u043b\\u044f, \\u043f\\u0440\\u043e\\u0432\\u043e\\u0434\\u0438\\u0432\\u0448\\u0435\\u0433\\u043e \\u043f\\u043e\\u0432\\u0435\\u0440\\u043a\\u0443 \\u0441\\u0440\\u0435\\u0434\\u0441\\u0442\\u0432 \\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u0439, \\u0438 \\u0437\\u043d\\u0430\\u043a\\u043e\\u043c \\u043f\\u043e\\u0432\\u0435\\u0440\\u043a\\u0438.\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"\\u041e\\u0442\\u0432\\u0435\\u0442 GPT\",\n      \"properties\": {\n        \"dtype\": \"object\",\n        \"num_unique_values\": 1,\n        \"samples\": [\n          \"\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{},"execution_count":40}]},{"cell_type":"markdown","source":["###**Тестирование обученной модели YandexGPT**"],"metadata":{"id":"0pGn9tINHUSv"}},{"cell_type":"code","source":["from google.colab import userdata\n","import requests\n","import json"],"metadata":{"id":"5QY4AqEeIeLH","executionInfo":{"status":"ok","timestamp":1715060325124,"user_tz":-180,"elapsed":7,"user":{"displayName":"Neo S_7OV","userId":"04165898625210484884"}}},"execution_count":5,"outputs":[]},{"cell_type":"code","source":["ID_FOLDER = userdata.get('ID_FOLDER')\n","OAuth_token = userdata.get('OAuth_token')"],"metadata":{"id":"ojH2QF-LIjjy","executionInfo":{"status":"ok","timestamp":1715060329314,"user_tz":-180,"elapsed":2186,"user":{"displayName":"Neo S_7OV","userId":"04165898625210484884"}}},"execution_count":6,"outputs":[]},{"cell_type":"code","source":["# URL для получения токена\n","URL = \"https://iam.api.cloud.yandex.net/iam/v1/tokens\"\n","\n","# Получение IAM-токена (с помощью request)\n","import requests\n","\n","headers = {\"Content-Type\": \"application/json\"}\n","\n","data = {\n","    \"yandexPassportOauthToken\": OAuth_token\n","}\n","\n","response = requests.post(URL, headers=headers, json=data)\n","\n","IAM_TOKEN = response.json()[\"iamToken\"]\n","expiresAt = response.json()[\"expiresAt\"]\n"],"metadata":{"id":"ZFVwBt5AIl2t"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["#Функция обращения к дообученной модели YandexGPT Pro: gptvniims-8, ID bt189v9v4329dbnhc8d4\n","import requests\n","import json\n","def get_gpt_response (ID_FOLDER, question):\n","\n","    req = {\n","            \"modelUri\": \"ds://bt189v9v4329dbnhc8d4\",\n","            \"completionOptions\": {\n","                \"stream\": False,\n","                \"temperature\": 0.0,\n","                \"maxTokens\": 2000\n","            },\n","            \"messages\": [\n","                {\n","                \"role\": \"system\",\n","                \"text\": \"Ты юридический консультант по метрологическому обеспечению, ответь подробно на вопрос клиента. При ответе ссылайся на статьи, главы и пункты нормативной документации. Не придумывай ничего от себя. Не отвечай на вопросы, не касающиеся метрологического обеспечения.\"\n","                },\n","                {\n","                \"role\": \"user\",\n","                \"text\": f\"{question}\"\n","                }\n","            ]\n","    }\n","\n","    headers = {\"Authorization\": f\"Bearer {IAM_TOKEN}\",\n","                   \"x-folder-id\": f\"{ID_FOLDER}\", }\n","    res = requests.post(\"https://llm.api.cloud.yandex.net/foundationModels/v1/completion\",\n","        headers=headers, json=req)\n","    json_data = json.loads(res.text)\n","    answer = json_data['result']['alternatives'][0]['message']['text']\n","\n","    return answer\n"],"metadata":{"id":"32jecyY5NB-Q","executionInfo":{"status":"ok","timestamp":1715060378427,"user_tz":-180,"elapsed":294,"user":{"displayName":"Neo S_7OV","userId":"04165898625210484884"}}},"execution_count":10,"outputs":[]},{"cell_type":"code","source":["question = 'В связи с введением иностранными компаниями торговых ограничений имеется проблема в приобретении сканирующих электронных и поляризационных микроскопов. В целях импортозамещения и недопущения снижения эффективности деятельности предприятия прошу Вас направить информацию об имеющихся аналогах средств измерений отечественных производителей средств измерений.'\n","gpt_answer = get_gpt_response(ID_FOLDER, question)\n","print (gpt_answer)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ACvAbg0FJNI7","executionInfo":{"status":"ok","timestamp":1715065045101,"user_tz":-180,"elapsed":4336,"user":{"displayName":"Neo S_7OV","userId":"04165898625210484884"}},"outputId":"cbec4f80-109c-4f03-91ac-300cc779f989"},"execution_count":36,"outputs":[{"output_type":"stream","name":"stdout","text":["В соответствии с пунктом 1 статьи 2 Федерального закона от 26.06.2008 \n","№ 102-ФЗ «Об обеспечении единства измерений» (далее – Федеральный закон) средства измерений, применяемые в сфере государственного регулирования обеспечения единства измерений, подлежат утверждению типа и поверке.  В соответствии с частью 3 статьи 12 Федерального закона средства измерений утвержденного типа, предназначенные для применения в сфере государственного регулировании обеспечения единства измерений и прошедшие поверку, могут быть использованы при выполнении измерений в сфере государственного регулирования. Таким образом, при наличии утвержденного типа средства измерений и свидетельства о поверке, средство измерений может быть использовано в сфере государственного регулирования, в том числе в целях импортозамещения. В связи с изложенным, для решения вопроса о возможности применения конкретного средства измерений необходимо учитывать его тип и наличие свидетельства о поверке.\n"]}]},{"cell_type":"code","source":["import pandas as pd\n","\n","# Загрузка перечня вопросов-ответов из файла Excel в DataFrame\n","df = pd.read_excel('output.xlsx')\n","df.head()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":206},"id":"MoOPxHu5kU0f","executionInfo":{"status":"ok","timestamp":1715060508086,"user_tz":-180,"elapsed":686,"user":{"displayName":"Neo S_7OV","userId":"04165898625210484884"}},"outputId":"78e42183-eb7f-41a1-e1b9-95102aada77a"},"execution_count":13,"outputs":[{"output_type":"execute_result","data":{"text/plain":["   № п/п                                             Вопрос  \\\n","0      1  Какие предъявляются требования к измерениям пр...   \n","1      2  Какой нормативный правовой акт устанавливает п...   \n","2      3  Допустимо ли проведение процедуры калибровки с...   \n","3      4  Возможно ли использование средств измерений в ...   \n","4      5  Нужно ли поверять все средства измерений, прим...   \n","\n","                                     Идеальный ответ  Ответ GPT  \n","0  Законодательство Российской Федерации об обесп...        NaN  \n","1  В соответствии с частью 1 статьи 9 Федеральног...        NaN  \n","2  Сфера государственного регулирования обеспечен...        NaN  \n","3  В связи с отсутствием в Вашем обращении информ...        NaN  \n","4  Управление метрологии, государственного контро...        NaN  "],"text/html":["\n","  <div id=\"df-1888069a-d7e1-49c3-8ab6-8822033520d5\" class=\"colab-df-container\">\n","    <div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>№ п/п</th>\n","      <th>Вопрос</th>\n"